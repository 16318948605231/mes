<Window x:Class="Mes.TestApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MES 连接库 · 测试界面" Height="720" Width="1040"
        WindowStartupLocation="CenterScreen" FontSize="13">
    <DockPanel Margin="10">

        <!-- 顶部：连接栏 -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                Padding="10" Margin="0,0,0,10" Background="#FAFAFA">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="协议：" VerticalAlignment="Center" />
                <ComboBox x:Name="ProtocolBox" Grid.Column="1" Width="200" Margin="4,0"
                          SelectedIndex="0" VerticalAlignment="Center">
                    <ComboBoxItem Content="InMemory（进程内回环 · 免服务器）" Tag="InMemory" />
                    <ComboBoxItem Content="REST（HTTP/JSON）" Tag="Rest" />
                    <ComboBoxItem Content="FileDrop（文件落地）" Tag="FileDrop" />
                    <ComboBoxItem Content="MQTT" Tag="Mqtt" />
                    <ComboBoxItem Content="Database（SQLite）" Tag="Database" />
                </ComboBox>

                <TextBlock Grid.Column="2" Text="端点/连接串：" VerticalAlignment="Center" Margin="10,0,0,0" />
                <TextBox x:Name="EndpointBox" Grid.Column="4" Margin="4,0" VerticalAlignment="Center"
                         ToolTip="REST: https://mes.example.com  |  FileDrop: C:\mes-exchange  |  MQTT: mqtt://broker:1883  |  Database: Data Source=mes.db" />

                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button x:Name="ConnectButton" Content="连接" Width="72" Margin="4,0" Click="OnConnectClick" />
                    <Button x:Name="DisconnectButton" Content="断开" Width="72" Margin="4,0" Click="OnDisconnectClick" IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 状态条 -->
        <Border DockPanel.Dock="Top" Padding="8,4" Margin="0,0,0,10" CornerRadius="4" Background="#EFEFEF">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="状态：" FontWeight="Bold" />
                <TextBlock x:Name="StatusText" Text="未连接" Margin="4,0,0,0" />
            </StackPanel>
        </Border>

        <!-- 底部：事件日志 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                Height="200" Margin="0,10,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Background="#F2F2F2">
                    <TextBlock Text="事件日志" FontWeight="Bold" Margin="8,4" />
                    <Button Content="清空" Margin="8,2" Padding="8,0" Click="OnClearLogClick" />
                </StackPanel>
                <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12" />
            </DockPanel>
        </Border>

        <!-- 中部：功能选项卡 -->
        <TabControl>
            <!-- 查询 -->
            <TabItem Header="查询">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="工单号：" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="WorkOrderIdBox" Grid.Row="0" Grid.Column="1" Text="WO-1001" Margin="4" VerticalAlignment="Center" />
                    <Button Grid.Row="0" Grid.Column="2" Content="查询工单" Width="96" Margin="4" Click="OnGetWorkOrderClick" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="序列号：" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="SerialQueryBox" Grid.Row="1" Grid.Column="1" Text="SN-0001" Margin="4" VerticalAlignment="Center" />
                    <Button Grid.Row="1" Grid.Column="2" Content="过站校验" Width="96" Margin="4" Click="OnCheckGateClick" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="工序：" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="OperationBox" Grid.Row="2" Grid.Column="1" Text="OP20" Margin="4" VerticalAlignment="Center" />

                    <TextBox x:Name="QueryResultBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                             Margin="4,10,4,4" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                             FontFamily="Consolas" Background="#FBFBFB" />
                </Grid>
            </TabItem>

            <!-- 上报检测结果 -->
            <TabItem Header="上报检测结果">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="序列号：" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="ReportSerialBox" Grid.Row="0" Grid.Column="1" Text="SN-0001" Margin="4" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="判定结果：" VerticalAlignment="Center" Margin="0,4" />
                    <ComboBox x:Name="OutcomeBox" Grid.Row="1" Grid.Column="1" Margin="4" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem Content="Pass（合格）" Tag="Pass" />
                        <ComboBoxItem Content="Fail（不合格）" Tag="Fail" />
                    </ComboBox>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="图像模式：" VerticalAlignment="Center" Margin="0,4" />
                    <ComboBox x:Name="ImageModeBox" Grid.Row="2" Grid.Column="1" Margin="4" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem Content="Embedded（内嵌到上报）" Tag="Embedded" />
                        <ComboBoxItem Content="SeparateUpload（单独上传后引用）" Tag="SeparateUpload" />
                        <ComboBoxItem Content="不附带图像" Tag="None" />
                    </ComboBox>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="图像文件：" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="ImagePathBox" Grid.Row="3" Grid.Column="1" Margin="4" VerticalAlignment="Center" IsReadOnly="True" />
                    <Button Grid.Row="3" Grid.Column="2" Content="浏览…" Width="96" Margin="4" Click="OnBrowseImageClick" />

                    <Button Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Content="上报检测结果"
                            Width="130" Margin="4,10,4,4" Click="OnReportInspectionClick" />

                    <TextBox x:Name="ReportResultBox" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
                             Margin="4,10,4,4" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                             FontFamily="Consolas" Background="#FBFBFB" />
                </Grid>
            </TabItem>

            <!-- 报警 -->
            <TabItem Header="报警">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="报警代码：" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="AlarmCodeBox" Grid.Row="0" Grid.Column="1" Text="E-1001" Margin="4" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="报警描述：" VerticalAlignment="Center" Margin="0,4" />
                    <TextBox x:Name="AlarmTextBox" Grid.Row="1" Grid.Column="1" Text="相机离线" Margin="4" VerticalAlignment="Center" />

                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="4,10,0,0">
                        <Button Content="触发报警" Width="96" Margin="0,0,8,0" Click="OnRaiseAlarmClick" />
                        <Button Content="解除报警" Width="96" Click="OnClearAlarmClick" />
                    </StackPanel>

                    <TextBox x:Name="AlarmResultBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                             Margin="4,10,4,4" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                             FontFamily="Consolas" Background="#FBFBFB" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

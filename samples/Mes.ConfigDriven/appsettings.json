{
  // ===========================================================================
  // 默认配置：使用进程内 InMemory 协议（mem://），零外部依赖即可运行。
  //
  // 关键点：外观检测软件的“每个阶段做哪些 MES 交互”完全来自本文件的 Mes.Workflows。
  // 换工厂时，只需换一份 appsettings（见 appsettings.FactoryA.json / appsettings.FactoryB.json），
  // 外观检测软件的代码一行都不用改。把 Enabled 置为 false，即可“一键关闭 MES”（全部空操作）。
  // ===========================================================================
  "Mes": {
    "Enabled": true,
    "ConnectionString": "mem://demo-factory",

    "Workflows": {
      // 软件启动：上报一次“检测软件已就绪”。
      "OnStartup": [
        { "Operation": "ReportInspection", "PayloadFrom": "startupHeartbeat" }
      ],

      // 检测前：取工单/配方并缓存到上下文（供后续步骤或软件读取）；
      // 过站校验决定本单元是否允许检测。
      // 这里的工单/配方查询标记为 Optional：查不到也不让该阶段失败（默认 mem:// 无预置数据即是此情况）。
      "BeforeInspection": [
        { "Operation": "CheckUnitPassed", "Args": { "serialNumber": "{serialNumber}", "operationId": "{operationId}" }, "CaptureTo": "gate" },
        { "Operation": "GetWorkOrder", "Args": { "workOrderId": "{workOrderId}" }, "CaptureTo": "workOrder", "Optional": true },
        { "Operation": "GetRecipe", "Args": { "recipeId": "{recipeId}" }, "CaptureTo": "recipe", "Optional": true }
      ],

      // 检测后：无条件上报检测结果。
      "AfterInspection": [
        { "Operation": "ReportInspection", "PayloadFrom": "inspectionResult" }
      ],

      // 合格：仅当 outcome==Pass 时上报测量值（可选）。
      "OnPass": [
        { "Operation": "ReportMeasurements", "When": "outcome == Pass", "PayloadFrom": "measurementsPayload", "Optional": true }
      ],

      // 不合格：仅当 outcome==Fail 时触发报警。
      "OnFail": [
        { "Operation": "RaiseAlarm", "When": "outcome == Fail", "Payload": { "code": "AOI_NG", "text": "SN {serialNumber} 外观检测不合格" } }
      ]
    }
  }
}

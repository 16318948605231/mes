{
  // ===========================================================================
  // 工厂 B（示例）：MQTT 协议的 MES。
  //
  // 与工厂 A 相比，仅连接字符串与操作到 MQTT 主题的映射不同；
  // 上报类操作用发布语义（RequestResponse=false）。Workflows 结构完全一致，
  // 外观检测软件代码零改动即可从“REST 工厂”切到“MQTT 工厂”。
  //
  // 注意：此处为演示 Broker，直接运行需要可访问的真实 MQTT Broker；
  // 若无真实 Broker，请用默认 appsettings.json（mem://）体验完整流程。
  // ===========================================================================
  "Mes": {
    "Enabled": true,
    "ConnectionString": "mqtt://mes.factoryB.local:1883?prefix=factoryB",

    // 把通用操作键映射到工厂 B 的 MQTT 主题。
    "OperationBindings": [
      { "OperationKey": "GetWorkOrder", "ChannelTemplate": "factoryB/workorders/{workOrderId}" },
      { "OperationKey": "GetRecipe", "ChannelTemplate": "factoryB/recipes/{recipeId}" },
      { "OperationKey": "CheckUnitPassed", "ChannelTemplate": "factoryB/gate/{serialNumber}/{operationId}" },
      { "OperationKey": "ReportInspection", "ChannelTemplate": "factoryB/inspections", "RequestResponse": false, "Qos": 1 },
      { "OperationKey": "ReportMeasurements", "ChannelTemplate": "factoryB/measurements", "RequestResponse": false, "Qos": 1 },
      { "OperationKey": "RaiseAlarm", "ChannelTemplate": "factoryB/alarms", "RequestResponse": false, "Qos": 1 }
    ],

    "Workflows": {
      "OnStartup": [
        { "Operation": "ReportInspection", "PayloadFrom": "startupHeartbeat" }
      ],
      "BeforeInspection": [
        { "Operation": "CheckUnitPassed", "Args": { "serialNumber": "{serialNumber}", "operationId": "{operationId}" }, "CaptureTo": "gate", "OnError": "Continue" },
        { "Operation": "GetWorkOrder", "Args": { "workOrderId": "{workOrderId}" }, "CaptureTo": "workOrder", "OnError": "Continue" },
        { "Operation": "GetRecipe", "Args": { "recipeId": "{recipeId}" }, "CaptureTo": "recipe", "OnError": "Continue" }
      ],
      "AfterInspection": [
        { "Operation": "ReportInspection", "PayloadFrom": "inspectionResult" }
      ],
      "OnPass": [
        { "Operation": "ReportMeasurements", "When": "outcome == Pass", "PayloadFrom": "measurementsPayload", "Optional": true }
      ],
      "OnFail": [
        { "Operation": "RaiseAlarm", "When": "outcome == Fail", "Payload": { "code": "AOI_NG", "text": "SN {serialNumber} 外观检测不合格" } }
      ]
    }
  }
}

{
  // ===========================================================================
  // 工厂 A（示例）：REST 协议的 MES。
  //
  // 与默认配置相比，只改了连接方式和操作到 REST 端点的映射（OperationBindings），
  // 而“检测前/中/后做什么”的 Workflows 保持一致——外观检测软件代码零改动。
  //
  // 注意：此处为演示端点，直接运行需要可访问的真实 REST 服务；
  // 若无真实服务器，请用默认 appsettings.json（mem://）体验完整流程。
  // ===========================================================================
  "Mes": {
    "Enabled": true,
    "ConnectionString": "rest://mes.factoryA.local/api?token=REPLACE_WITH_TOKEN",

    // 把通用操作键映射到工厂 A 的具体 REST 端点。
    "OperationBindings": [
      { "OperationKey": "GetWorkOrder", "ChannelTemplate": "workorders/{workOrderId}", "Verb": "GET" },
      { "OperationKey": "GetRecipe", "ChannelTemplate": "recipes/{recipeId}", "Verb": "GET" },
      { "OperationKey": "CheckUnitPassed", "ChannelTemplate": "units/{serialNumber}/gate/{operationId}", "Verb": "GET" },
      { "OperationKey": "ReportInspection", "ChannelTemplate": "inspections", "Verb": "POST", "RequestResponse": true },
      { "OperationKey": "ReportMeasurements", "ChannelTemplate": "measurements", "Verb": "POST", "RequestResponse": true },
      { "OperationKey": "RaiseAlarm", "ChannelTemplate": "alarms", "Verb": "POST", "RequestResponse": true }
    ],

    "Workflows": {
      "OnStartup": [
        { "Operation": "ReportInspection", "PayloadFrom": "startupHeartbeat" }
      ],
      "BeforeInspection": [
        { "Operation": "CheckUnitPassed", "Args": { "serialNumber": "{serialNumber}", "operationId": "{operationId}" }, "CaptureTo": "gate" },
        { "Operation": "GetWorkOrder", "Args": { "workOrderId": "{workOrderId}" }, "CaptureTo": "workOrder", "OnError": "Continue" },
        { "Operation": "GetRecipe", "Args": { "recipeId": "{recipeId}" }, "CaptureTo": "recipe", "OnError": "Continue" }
      ],
      "AfterInspection": [
        { "Operation": "ReportInspection", "PayloadFrom": "inspectionResult" }
      ],
      "OnPass": [
        { "Operation": "ReportMeasurements", "When": "outcome == Pass", "PayloadFrom": "measurementsPayload", "Optional": true }
      ],
      "OnFail": [
        { "Operation": "RaiseAlarm", "When": "outcome == Fail", "Payload": { "code": "AOI_NG", "text": "SN {serialNumber} 外观检测不合格" } }
      ]
    }
  }
}

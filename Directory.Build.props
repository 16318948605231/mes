<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
    <Company>MES Connectivity Toolkit</Company>
    <Product>MES Connectivity Toolkit</Product>
    <Version>1.0.0</Version>
    <Copyright>Copyright (c) MES Connectivity Toolkit contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/16318948605231/mes</RepositoryUrl>
  </PropertyGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(MesLibraryTargetFrameworks)</TargetFrameworks>
    <Description>MES 连接库聚合包：一次引入全部协议 Provider（REST/MQTT/OPC UA/文件/数据库/SECS-GEM/SOAP/WebSocket/Kafka/AMQP/gRPC/InMemory），并提供“一行连接字符串 + AddMes(IConfiguration)”的极简接入方式。</Description>
    <PackageTags>$(PackageTags);aggregate;all;rest;mqtt;opcua;kafka;amqp;grpc;soap;websocket</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mes.Core\Mes.Core.csproj" />
    <ProjectReference Include="..\Mes.Protocols.InMemory\Mes.Protocols.InMemory.csproj" />
    <ProjectReference Include="..\Mes.Protocols.Rest\Mes.Protocols.Rest.csproj" />
    <ProjectReference Include="..\Mes.Protocols.Mqtt\Mes.Protocols.Mqtt.csproj" />
    <ProjectReference Include="..\Mes.Protocols.OpcUa\Mes.Protocols.OpcUa.csproj" />
    <ProjectReference Include="..\Mes.Protocols.FileDrop\Mes.Protocols.FileDrop.csproj" />
    <ProjectReference Include="..\Mes.Protocols.Database\Mes.Protocols.Database.csproj" />
    <ProjectReference Include="..\Mes.Protocols.SecsGem\Mes.Protocols.SecsGem.csproj" />
    <ProjectReference Include="..\Mes.Protocols.Soap\Mes.Protocols.Soap.csproj" />
    <ProjectReference Include="..\Mes.Protocols.WebSocket\Mes.Protocols.WebSocket.csproj" />
    <ProjectReference Include="..\Mes.Protocols.Kafka\Mes.Protocols.Kafka.csproj" />
    <ProjectReference Include="..\Mes.Protocols.Amqp\Mes.Protocols.Amqp.csproj" />
    <ProjectReference Include="..\Mes.Protocols.Grpc\Mes.Protocols.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
